NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=Reminder Rocket <noreply@reminderrocket.com>
# SMS provider: "vonage" (default) or "highlevel" (uses your A2P-verified GHL number)
SMS_PROVIDER=vonage
# Vonage SMS (Dashboard: API key + API secret; sender = your Vonage number or approved alphanumeric)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_SMS_FROM=12025550123
# GoHighLevel SMS (uses the sub-account's default A2P-verified number)
# Sub-Account → Settings → Private Integrations → create token with "conversations" + "contacts" scopes.
HIGHLEVEL_PIT_TOKEN=your_highlevel_private_integration_token
# Sub-Account → Settings → Business Profile → Location ID (or grab it from any agency-level URL).
HIGHLEVEL_LOCATION_ID=your_highlevel_location_id
APP_BASE_URL=http://localhost:3000
# Telegram bot token (BotFather -> /newbot). Required for Telegram reminder delivery.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Shared secret between the long-running Telegram bot service and this app.
# Used to authenticate in-Telegram photo proof uploads. Must match on both sides.
REMINDERROCKET_BOT_SECRET=your_random_long_secret
